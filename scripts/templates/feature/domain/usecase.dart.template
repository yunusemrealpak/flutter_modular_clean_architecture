import 'package:core/core.dart';

import '../entities/example_entity.dart';
import '../repositories/example_repository.dart';

/// Use case for fetching example data
///
/// This use case encapsulates the business logic for retrieving
/// example data from the repository. It follows the Single Responsibility
/// Principle by handling only one specific business operation.
@lazySingleton
class GetExampleDataUseCase extends UseCase<ExampleEntity, GetExampleDataParams> {
  final ExampleRepository repository;

  GetExampleDataUseCase(this.repository);

  @override
  Future<Either<Failure, ExampleEntity>> call(GetExampleDataParams params) async {
    // Validate input
    if (params.id.isEmpty) {
      return const Left(ValidationFailure(message: 'ID cannot be empty'));
    }

    // Call repository
    return await repository.getExampleData(params.id);
  }
}

/// Parameters for GetExampleDataUseCase
class GetExampleDataParams {
  final String id;

  const GetExampleDataParams({required this.id});
}
