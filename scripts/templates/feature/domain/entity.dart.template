import 'package:equatable/equatable.dart';

/// Example entity for {{PACKAGE_NAME_PASCAL}} feature
///
/// This is a business entity that represents the core data structure
/// used in the domain layer. It should contain only business logic
/// and be independent of any data source or presentation layer.
class ExampleEntity extends Equatable {
  /// Unique identifier
  final String id;

  /// Name of the entity
  final String name;

  /// Detailed description
  final String description;

  /// Creation timestamp
  final DateTime createdAt;

  /// Last update timestamp (nullable)
  final DateTime? updatedAt;

  const ExampleEntity({
    required this.id,
    required this.name,
    required this.description,
    required this.createdAt,
    this.updatedAt,
  });

  /// Business logic: Check if entity was created recently (within last 7 days)
  bool get isRecent {
    final now = DateTime.now();
    final difference = now.difference(createdAt);
    return difference.inDays < 7;
  }

  /// Business logic: Check if entity has been updated
  bool get isUpdated => updatedAt != null;

  /// Business logic: Get display name (capitalize first letter)
  String get displayName =>
      name.isEmpty ? 'Unknown' : '${name[0].toUpperCase()}${name.substring(1)}';

  @override
  List<Object?> get props => [id, name, description, createdAt, updatedAt];

  @override
  bool get stringify => true;
}
