import 'package:core/core.dart';
import 'package:network/network.dart';

import '../../domain/entities/example_entity.dart';
import '../../domain/repositories/example_repository.dart';
import '../datasources/example_local_datasource.dart';
import '../datasources/example_remote_datasource.dart';

/// Repository implementation for {{PACKAGE_NAME_PASCAL}} feature
///
/// Implements cache-first strategy:
/// 1. Try to get from cache
/// 2. If not found or needs refresh, fetch from remote
/// 3. Cache the remote data
/// 4. Return the result
@LazySingleton(as: ExampleRepository)
class ExampleRepositoryImpl implements ExampleRepository {
  final ExampleRemoteDataSource remoteDataSource;
  final ExampleLocalDataSource localDataSource;
  final NetworkInfo networkInfo;

  ExampleRepositoryImpl({
    required this.remoteDataSource,
    required this.localDataSource,
    required this.networkInfo,
  });

  @override
  Future<Either<Failure, ExampleEntity>> getExampleData(String id) async {
    try {
      // Try to get from cache first
      final cachedModel = await localDataSource.getCachedExampleData(id);

      if (cachedModel != null) {
        return Right(cachedModel.toEntity());
      }

      // Check internet connection
      if (!await networkInfo.isConnected) {
        return const Left(
          NetworkFailure(message: 'No internet connection'),
        );
      }

      // Fetch from remote
      final remoteModel = await remoteDataSource.getExampleData(id);

      // Cache the result
      await localDataSource.cacheExampleData(remoteModel);

      return Right(remoteModel.toEntity());
    } on NetworkException catch (e) {
      return Left(_mapNetworkExceptionToFailure(e));
    } catch (e) {
      return Left(UnknownFailure(message: e.toString()));
    }
  }

  @override
  Future<Either<Failure, List<ExampleEntity>>> getAllExampleData() async {
    try {
      // Check internet connection
      if (!await networkInfo.isConnected) {
        // Try to get from cache if offline
        final cachedModels = await localDataSource.getAllCachedExampleData();
        if (cachedModels.isNotEmpty) {
          return Right(cachedModels.map((m) => m.toEntity()).toList());
        }
        return const Left(
          NetworkFailure(message: 'No internet connection and no cached data'),
        );
      }

      // Fetch from remote
      final remoteModels = await remoteDataSource.getAllExampleData();

      // Cache all results
      for (final model in remoteModels) {
        await localDataSource.cacheExampleData(model);
      }

      return Right(remoteModels.map((m) => m.toEntity()).toList());
    } on NetworkException catch (e) {
      return Left(_mapNetworkExceptionToFailure(e));
    } catch (e) {
      return Left(UnknownFailure(message: e.toString()));
    }
  }

  @override
  Future<Either<Failure, ExampleEntity>> createExampleData(
    ExampleEntity entity,
  ) async {
    try {
      // Check internet connection
      if (!await networkInfo.isConnected) {
        return const Left(
          NetworkFailure(message: 'No internet connection'),
        );
      }

      // Create via API
      final model = ExampleModel.fromEntity(entity);
      final createdModel = await remoteDataSource.createExampleData(model);

      // Cache the result
      await localDataSource.cacheExampleData(createdModel);

      return Right(createdModel.toEntity());
    } on NetworkException catch (e) {
      return Left(_mapNetworkExceptionToFailure(e));
    } catch (e) {
      return Left(UnknownFailure(message: e.toString()));
    }
  }

  @override
  Future<Either<Failure, ExampleEntity>> updateExampleData(
    ExampleEntity entity,
  ) async {
    try {
      // Check internet connection
      if (!await networkInfo.isConnected) {
        return const Left(
          NetworkFailure(message: 'No internet connection'),
        );
      }

      // Update via API
      final model = ExampleModel.fromEntity(entity);
      final updatedModel = await remoteDataSource.updateExampleData(model);

      // Update cache
      await localDataSource.cacheExampleData(updatedModel);

      return Right(updatedModel.toEntity());
    } on NetworkException catch (e) {
      return Left(_mapNetworkExceptionToFailure(e));
    } catch (e) {
      return Left(UnknownFailure(message: e.toString()));
    }
  }

  @override
  Future<Either<Failure, void>> deleteExampleData(String id) async {
    try {
      // Check internet connection
      if (!await networkInfo.isConnected) {
        return const Left(
          NetworkFailure(message: 'No internet connection'),
        );
      }

      // Delete via API
      await remoteDataSource.deleteExampleData(id);

      // Delete from cache
      await localDataSource.deleteCachedExampleData(id);

      return const Right(null);
    } on NetworkException catch (e) {
      return Left(_mapNetworkExceptionToFailure(e));
    } catch (e) {
      return Left(UnknownFailure(message: e.toString()));
    }
  }

  /// Map NetworkException to appropriate Failure
  Failure _mapNetworkExceptionToFailure(NetworkException exception) {
    if (exception is UnauthorizedException) {
      return const AuthFailure(message: 'Unauthorized access');
    } else if (exception is NotFoundException) {
      return const NotFoundFailure(message: 'Resource not found');
    } else if (exception is ServerException) {
      return ServerFailure(message: exception.message);
    } else if (exception is NoInternetException) {
      return const NetworkFailure(message: 'No internet connection');
    } else {
      return NetworkFailure(message: exception.message);
    }
  }
}
