import 'package:core/core.dart';
import 'package:network/network.dart';

import '../models/example_model.dart';

/// Remote datasource for {{PACKAGE_NAME_PASCAL}} feature
///
/// Handles API calls using HttpClient
@lazySingleton
class ExampleRemoteDataSource {
  final HttpClient httpClient;

  ExampleRemoteDataSource(this.httpClient);

  /// Fetch example data from API by ID
  Future<ExampleModel> getExampleData(String id) async {
    final response = await httpClient.get<Map<String, dynamic>>(
      '/api/example/$id',
    );

    return ExampleModel.fromJson(response.data!);
  }

  /// Fetch all example data from API
  Future<List<ExampleModel>> getAllExampleData() async {
    final response = await httpClient.get<List<dynamic>>(
      '/api/example',
    );

    return response.data!
        .map((json) => ExampleModel.fromJson(json as Map<String, dynamic>))
        .toList();
  }

  /// Create new example data via API
  Future<ExampleModel> createExampleData(ExampleModel model) async {
    final response = await httpClient.post<Map<String, dynamic>>(
      '/api/example',
      data: model.toJson(),
    );

    return ExampleModel.fromJson(response.data!);
  }

  /// Update existing example data via API
  Future<ExampleModel> updateExampleData(ExampleModel model) async {
    final response = await httpClient.put<Map<String, dynamic>>(
      '/api/example/${model.data.id}',
      data: model.toJson(),
    );

    return ExampleModel.fromJson(response.data!);
  }

  /// Delete example data via API
  Future<void> deleteExampleData(String id) async {
    await httpClient.delete('/api/example/$id');
  }
}
